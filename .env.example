# Робота без бекенду: mock. Після підключення CMS/API: api.
NEXT_PUBLIC_CATALOG_MODE=mock

# Адреса API або вашого адаптера. Без косої риски наприкінці.
NEXT_PUBLIC_API_URL=https://api.example.com

# GET endpoint каталогу. Відповідь має відповідати ProductCatalog JCOS.
NEXT_PUBLIC_CATALOG_ENDPOINT=/catalog

# Endpoints для заявок. У production їх потрібно вказати: без них сайт
# чесно покаже помилку й не підтвердить заявку, яка нікуди не надійшла.
NEXT_PUBLIC_QUICK_ORDER_ENDPOINT=
NEXT_PUBLIC_ORDER_ENDPOINT=
NEXT_PUBLIC_CALLBACK_ENDPOINT=

# Нова пошта. Ключ додавай лише до .env.local або змінних хостингу — не у git.
NOVA_POSHTA_API_KEY=
# Необов'язково: стандартний endpoint вже використовується за замовчуванням.
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

# Захист CMS у production. Не коміть реальний пароль у git: задай його
# лише у змінних середовища хостингу або у локальному .env.local.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Адреса вітрини для SEO та посилань.
NEXT_PUBLIC_SITE_URL=https://heymom.com.ua
