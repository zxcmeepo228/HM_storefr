{
  "name": "storefront-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-next.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "import:heymom": "node scripts/import-heymom-products.mjs --lang=ru",
    "import:heymom:uk": "node scripts/import-heymom-products.mjs --lang=uk",
    "import:heymom:reviews": "node scripts/import-heymom-reviews.mjs",
    "sync:heymom-media": "node scripts/sync-heymom-media.mjs",
    "sync:heymom-media:uk": "node scripts/sync-heymom-media.mjs --input=src/catalog/data/heymom-products.uk.json",
    "audit:heymom": "node scripts/audit-heymom-catalog.mjs",
    "audit:heymom:uk": "node scripts/audit-heymom-catalog.mjs --input=src/catalog/data/heymom-products.uk.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.9",
    "cheerio": "^1.1.2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.2"
    ,"vitest": "^3.2.4"
  }
